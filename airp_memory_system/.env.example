# ============================================
# AIRP Memory System Configuration
# ============================================

# Application Settings
APP_NAME="AIRP Memory System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8001
WORKERS=4

# ============================================
# Neo4j Configuration (Graphiti Backend)
# ============================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j

# Neo4j Connection Pool
NEO4J_MAX_CONNECTIONS=50
NEO4J_MAX_ACQUISITION_TIME=60
NEO4J_MAX_TRANSACTION_RETRY_TIME=30

# ============================================
# DeepSeek API Configuration
# ============================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=3

# ============================================
# SiliconFlow API Configuration
# ============================================
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=1024
SILICONFLOW_TIMEOUT=30
SILICONFLOW_MAX_RETRIES=3

# ============================================
# Redis Configuration (Cache)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_CACHE_TTL=3600

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/airp_memory.log

# ============================================
# Graphiti Configuration
# ============================================
GRAPHITI_ENABLE_INDICES=true
GRAPHITI_SEARCH_NUM_RESULTS=10
GRAPHITI_EPISODE_BATCH_SIZE=10

# LLM Configuration for Graphiti
GRAPHITI_LLM_PROVIDER=deepseek
GRAPHITI_LLM_MODEL=deepseek-chat
GRAPHITI_LLM_TEMPERATURE=0.1

# Embedding Configuration for Graphiti
GRAPHITI_EMBEDDING_PROVIDER=siliconflow
GRAPHITI_EMBEDDING_MODEL=BAAI/bge-m3

# ============================================
# Security Configuration
# ============================================
ALLOWED_ORIGINS=["*"]
API_KEY_HEADER=X-API-Key
API_KEY=your_optional_api_key_here

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOW_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
